datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

model PriceTick {
  id                   String   @id @default(cuid())
  symbol               String
  region               String? // e.g., "US", "EU", "ASIA"
  exchange             String? // e.g., "NASDAQ", "NYSE"
  timestamp            DateTime
  open                 Decimal
  high                 Decimal
  low                  Decimal
  close                Decimal
  adjustedClose        Decimal?
  volume               BigInt?
  source               String? // e.g., "yahoo", "coinbase"
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("COMPLETE")

  @@unique([symbol, timestamp])
  @@index([symbol, timestamp])
  @@index([region])
  @@map("price_ticks")
}

model LatestPrice {
  symbol    String   @id
  region    String? // region for filtering
  price     Decimal
  timestamp DateTime
  updatedAt DateTime @updatedAt

  @@map("latest_prices")
}

model Stock {
  id                           String   @id @default(cuid())
  symbol                       String   @unique
  name                         String
  region                       String   // IN, US, EU, UK, CN
  exchange                     String?
  country                      String?
  sector                       String?
  industry                     String?
  currency                     String?
  marketCap                    Decimal?
  assetType                    String?
  isDelisted                   Boolean  @default(false)
  ipoDate                      DateTime?
  isin                         String?
  source                       String   @default("database")
  dataStatus                   String   @default("PARTIAL")
  isActive                     Boolean  @default(true)
  lastSuccessfulDataLoadTimestamp DateTime?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  fundamentals                 Fundamental[]
  corporateActions             CorporateAction[]
  signalResults                SignalResult[]
  portfolioHoldings            PortfolioHolding[]
  portfolioTransactions        PortfolioTransaction[]
  watchlistItems                WatchlistItem[]

  @@map("stocks")
}

model SignalResult {
  id               String   @id @default(cuid())
  instrumentId     String
  stock            Stock    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol           String
  companyName      String?
  sector           String?
  country          String?
  score            Float
  direction        String
  confidence       String
  triggeredSignals Json
  negativeSignals  Json
  explanation      String
  generatedAt      DateTime @default(now())
  source           String   @default("signal-generation-engine")
  dataStatus       String   @default("PARTIAL")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([instrumentId, generatedAt])
  @@index([direction, score])
  @@index([sector])
  @@index([country])
  @@map("signal_results")
}

model Fundamental {
  id                   String   @id @default(cuid())
  stockId              String
  stock                Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  revenue              Decimal?
  eps                  Decimal?
  netIncome            Decimal?
  peRatio              Decimal?
  dividendYield        Decimal?
  sharesOutstanding    BigInt?
  marketCap            Decimal?
  currency             String?
  periodType           String
  periodEndDate        DateTime
  source               String
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("PARTIAL")

  @@unique([stockId, periodType, periodEndDate, source])
  @@index([stockId, periodEndDate])
  @@map("fundamentals")
}

model CorporateAction {
  id                   String   @id @default(cuid())
  stockId              String
  stock                Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  actionType           String
  effectiveDate        DateTime
  declaredDate         DateTime?
  paymentDate          DateTime?
  amount               Decimal?
  splitRatio           Decimal?
  currency             String?
  source               String
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("COMPLETE")

  @@unique([stockId, actionType, effectiveDate, source])
  @@index([stockId, effectiveDate])
  @@map("corporate_actions")
}

model FxRate {
  id                   String   @id @default(cuid())
  pair                 String   @unique
  baseCurrency         String
  quoteCurrency        String
  rate                 Decimal
  rateTimestamp        DateTime
  source               String
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("COMPLETE")

  @@index([baseCurrency, quoteCurrency])
  @@map("fx_rates")
}

model Portfolio {
  id           String                 @id @default(cuid())
  name         String
  baseCurrency String
  description  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  holdings     PortfolioHolding[]
  transactions PortfolioTransaction[]

  @@map("portfolios")
}

model PortfolioHolding {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrumentId String
  stock       Stock     @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol      String
  companyName String?
  quantity    Decimal
  averageCost Decimal
  currency    String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([portfolioId, instrumentId])
  @@index([portfolioId])
  @@index([instrumentId])
  @@map("portfolio_holdings")
}

model PortfolioTransaction {
  id              String    @id @default(cuid())
  portfolioId     String
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrumentId    String?
  stock           Stock?    @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  type            String
  quantity        Decimal?
  price           Decimal?
  amount          Decimal?
  currency        String
  transactionDate DateTime
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([portfolioId, transactionDate])
  @@index([instrumentId])
  @@map("portfolio_transactions")
}

model Watchlist {
  id          String          @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       WatchlistItem[]

  @@map("watchlists")
}

model WatchlistItem {
  id           String    @id @default(cuid())
  watchlistId  String
  watchlist    Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  instrumentId String
  stock        Stock     @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol       String
  companyName  String?
  notes        String?
  tags         Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([watchlistId, instrumentId])
  @@index([watchlistId])
  @@index([instrumentId])
  @@map("watchlist_items")
}






