datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

model PriceTick {
  id                   String            @id @default(cuid())
  symbol               String
  region               String? // e.g., "US", "EU", "ASIA"
  exchange             String? // e.g., "NASDAQ", "NYSE"
  timestamp            DateTime
  open                 Decimal
  high                 Decimal
  low                  Decimal
  close                Decimal
  adjustedClose        Decimal?
  volume               BigInt?
  source               String? // e.g., "yahoo", "coinbase"
  sourceFileImportId   String?
  sourceFileImport     SourceFileImport? @relation(fields: [sourceFileImportId], references: [id], onDelete: SetNull)
  ingestionTimestamp   DateTime          @default(now())
  lastUpdatedTimestamp DateTime          @updatedAt
  dataStatus           String            @default("COMPLETE")

  @@unique([symbol, timestamp])
  @@index([symbol, timestamp])
  @@index([region])
  @@index([sourceFileImportId])
  @@map("price_ticks")
}

model LatestPrice {
  symbol    String   @id
  region    String? // region for filtering
  price     Decimal
  timestamp DateTime
  updatedAt DateTime @updatedAt

  @@map("latest_prices")
}

model Stock {
  id                              String                         @id @default(cuid())
  symbol                          String                         @unique
  name                            String
  region                          String // IN, US, EU, UK, CN
  exchange                        String?
  country                         String?
  sector                          String?
  industry                        String?
  currency                        String?
  marketCap                       Decimal?
  assetType                       String?
  instrumentSegment               String?
  displaySymbol                   String?
  providerSymbol                  String?
  sourceSymbol                    String?
  catalogSource                   String?
  providerSupportStatus           String?
  providerError                   String?
  derivativesEligible             Boolean                        @default(false)
  underlyingSymbol                String?
  expiryDate                      DateTime?
  contractMonth                   String?
  lotSize                         Int?
  contractStatus                  String?
  isDelisted                      Boolean                        @default(false)
  ipoDate                         DateTime?
  isin                            String?
  source                          String                         @default("database")
  dataStatus                      String                         @default("PARTIAL")
  isActive                        Boolean                        @default(true)
  lastSuccessfulDataLoadTimestamp DateTime?
  createdAt                       DateTime                       @default(now())
  updatedAt                       DateTime                       @updatedAt
  fundamentals                    Fundamental[]
  corporateActions                CorporateAction[]
  signalResults                   SignalResult[]
  dataQualityEvaluations          DataQualityEvaluation[]
  portfolioHoldings               PortfolioHolding[]
  portfolioTransactions           PortfolioTransaction[]
  watchlistItems                  WatchlistItem[]
  alertRules                      AlertRule[]
  alertEvents                     AlertEvent[]
  smartMoneySnapshots             SmartMoneyContextSnapshot[]
  strategyDecisions               StrategyDecisionResult[]
  marketDataRepairAttempts        MarketDataRepairAttempt[]
  marketDataRepairStates          MarketDataRepairState[]
  signalPositionLedgerEntries     SignalPositionLedgerEntry[]
  exchangeIdentities              InstrumentExchangeIdentity[]
  deliverySnapshots               MarketDeliverySnapshot[]
  stockInterestSnapshots          StockInterestSnapshot[]
  earningsIntelligenceSnapshots   EarningsIntelligenceSnapshot[]

  @@index([region, assetType, symbol], map: "stocks_region_assetType_symbol_idx")
  @@index([region, assetType, providerSupportStatus, isActive, isDelisted], map: "stocks_region_assetType_providerSupport_active_delisted_idx")
  @@map("stocks")
}

model SourceFileImport {
  id                           String                       @id @default(cuid())
  source                       String
  segment                      String
  tradingDate                  DateTime
  fileName                     String
  fileUrl                      String?
  fileHash                     String
  fileSize                     Int?
  status                       String
  rowsRaw                      Int                          @default(0)
  rowsAccepted                 Int                          @default(0)
  rowsRejected                 Int                          @default(0)
  parserVersion                String
  importedAt                   DateTime                     @default(now())
  errorMessage                 String?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  priceTicks                   PriceTick[]
  instrumentExchangeIdentities InstrumentExchangeIdentity[]
  deliverySnapshots            MarketDeliverySnapshot[]

  @@unique([source, segment, tradingDate, fileHash])
  @@index([source, segment, tradingDate, status])
  @@map("source_file_imports")
}

model InstrumentExchangeIdentity {
  id                 String            @id @default(cuid())
  stockId            String
  stock              Stock             @relation(fields: [stockId], references: [id], onDelete: Cascade)
  exchange           String
  isin               String?
  exchangeSymbol     String
  securityCode       String?
  securityId         String?
  series             String?
  status             String
  sourceFileImportId String?
  sourceFileImport   SourceFileImport? @relation(fields: [sourceFileImportId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([stockId, exchange, exchangeSymbol])
  @@index([exchange, exchangeSymbol])
  @@index([exchange, isin])
  @@index([sourceFileImportId])
  @@map("instrument_exchange_identities")
}

model MarketDeliverySnapshot {
  id                  String            @id @default(cuid())
  stockId             String
  stock               Stock             @relation(fields: [stockId], references: [id], onDelete: Cascade)
  symbol              String
  exchange            String            @default("NSE")
  tradingDate         DateTime
  tradedQuantity      BigInt?
  deliverableQuantity BigInt?
  deliveryPercent     Decimal?
  source              String
  sourceFileImportId  String?
  sourceFileImport    SourceFileImport? @relation(fields: [sourceFileImportId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([stockId, exchange, tradingDate, source])
  @@index([symbol, tradingDate])
  @@index([tradingDate, exchange])
  @@index([sourceFileImportId])
  @@map("market_delivery_snapshots")
}

model EarningsIntelligenceSnapshot {
  id                 String    @id @default(cuid())
  snapshotDate       DateTime
  dataThroughDate    DateTime?
  stockId            String
  stock              Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  symbol             String
  scopeRegion        String
  scopeAssetType     String
  resultDate         DateTime?
  resultDateSource   String    @default("UNKNOWN")
  periodEndDate      DateTime?
  validatedAt        DateTime?
  daysToResult       Int?
  revenueGrowth      Float?
  profitGrowth       Float?
  epsGrowth          Float?
  marginTrend        Float?
  consistencyScore   Float
  accelerationScore  Float
  reasonTags         Json      @default("[]")
  riskTags           Json      @default("[]")
  warnings           Json      @default("[]")
  freshness          String
  categories         Json      @default("[]")
  calculationVersion String    @default("earnings-intelligence-v1")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([snapshotDate, scopeRegion, scopeAssetType, symbol], map: "earnings_intel_snapshot_scope_symbol_key")
  @@index([scopeRegion, scopeAssetType, snapshotDate], map: "earnings_intel_snapshot_scope_date_idx")
  @@index([scopeRegion, scopeAssetType, resultDate], map: "earnings_intel_snapshot_result_date_idx")
  @@index([stockId, snapshotDate], map: "earnings_intel_snapshot_stock_date_idx")
  @@map("earnings_intelligence_snapshots")
}

model StockInterestSnapshot {
  id                 String    @id @default(cuid())
  snapshotDate       DateTime
  dataThroughDate    DateTime?
  generatedAt        DateTime  @default(now())
  stockId            String
  stock              Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  symbol             String
  company            String
  sector             String?
  scopeRegion        String    @default("IN")
  scopeAssetType     String    @default("STOCK")
  timeframe          String    @default("1d")
  category           String
  score              Float
  direction          String
  reasonTags         Json      @default("[]")
  riskTags           Json      @default("[]")
  freshness          String
  warnings           Json      @default("[]")
  calculationVersion String    @default("stock-interest-v1")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([snapshotDate, scopeRegion, scopeAssetType, timeframe, category, symbol], map: "stock_interest_snapshot_scope_category_symbol_key")
  @@index([scopeRegion, scopeAssetType, timeframe, snapshotDate], map: "stock_interest_snapshot_scope_date_idx")
  @@index([scopeRegion, scopeAssetType, category, score], map: "stock_interest_snapshot_scope_category_score_idx")
  @@index([stockId, snapshotDate], map: "stock_interest_snapshot_stock_date_idx")
  @@map("stock_interest_snapshots")
}

model MarketDataRepairAttempt {
  id                   String    @id @default(cuid())
  stockId              String
  stock                Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  region               String
  assetType            String?
  repairType           String
  status               String
  provider             String?
  attemptedAt          DateTime  @default(now())
  completedAt          DateTime?
  fieldsFilledJson     Json?
  error                String?
  manualRequiredReason String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([stockId, repairType, status, attemptedAt])
  @@index([region, assetType, repairType, status])
  @@map("market_data_repair_attempts")
}

model MarketDataRepairState {
  id                   String    @id @default(cuid())
  stockId              String
  stock                Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  region               String
  assetType            String?
  repairType           String
  status               String
  provider             String?
  lastAttemptId        String?
  fieldsFilledJson     Json?
  error                String?
  manualRequiredReason String?
  nextRetryAt          DateTime?
  firstDetectedAt      DateTime  @default(now())
  lastAttemptedAt      DateTime?
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([stockId, repairType])
  @@index([region, assetType, repairType, status])
  @@index([repairType, status, nextRetryAt])
  @@map("market_data_repair_states")
}

model MarketDataRepairRun {
  id                   String    @id @default(cuid())
  region               String
  assetType            String?
  status               String
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  beforeHealthJson     Json?
  afterHealthJson      Json?
  beforeRepairPlanJson Json?
  afterRepairPlanJson  Json?
  actionsJson          Json
  summaryJson          Json?
  warningsJson         Json?
  error                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([region, assetType, status, startedAt])
  @@map("market_data_repair_runs")
}

model SignalResult {
  id                             String               @id @default(cuid())
  instrumentId                   String
  stock                          Stock                @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  generationRunId                String?
  generationRun                  SignalGenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  symbol                         String
  companyName                    String?
  sector                         String?
  country                        String?
  score                          Float
  direction                      String
  confidence                     String
  triggeredSignals               Json
  negativeSignals                Json
  explanation                    String
  generatedAt                    DateTime             @default(now())
  generatedDate                  DateTime?
  modelVersion                   String               @default("signal-engine-v1")
  rulesetVersion                 String?
  sourceDataDate                 DateTime?
  sourcePriceDate                DateTime?
  scoringInputSummary            Json?
  dataQualityEligibilitySnapshot Json?
  source                         String               @default("signal-generation-engine")
  dataStatus                     String               @default("PARTIAL")
  reliabilityTier                String?
  /// EXIT-candidate lifecycle state: ENTRY | ACTIVE | EXIT | EXPIRED (nullable for pre-migration rows)
  lifecycleState                 String?
  /// Score from the immediately prior persisted run for the same instrument+modelVersion (nullable)
  priorScore                     Float?
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt

  signalOutcomes SignalOutcome[]

  @@unique([instrumentId, modelVersion, generatedDate])
  @@index([generationRunId])
  @@index([modelVersion, sourceDataDate])
  @@index([instrumentId, generatedAt])
  @@index([direction, score])
  @@index([lifecycleState])
  @@index([sector])
  @@index([country])
  @@map("signal_results")
}

model SignalOutcome {
  id             String       @id @default(cuid())
  signalResultId String
  signalResult   SignalResult @relation(fields: [signalResultId], references: [id], onDelete: Cascade)

  // Denormalized for fast analytic queries (avoid join to SignalResult every time)
  instrumentId        String
  symbol              String
  direction           String
  score               Float
  sector              String?
  country             String?
  modelVersion        String
  signalGeneratedDate DateTime

  horizon String // '1D' | '5D' | '10D' | '20D' | '60D'

  dataComplete         Boolean   @default(false)
  priceAtSignal        Float?
  futurePrice          Float?
  windowEndDate        DateTime?
  forwardReturnPercent Float?

  maxFavorableExcursion Float?
  maxAdverseExcursion   Float?
  maxDrawdownPercent    Float?

  evaluatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([signalResultId, horizon])
  @@index([instrumentId, horizon, signalGeneratedDate])
  @@index([modelVersion, horizon, signalGeneratedDate])
  @@index([sector, horizon])
  @@index([direction, horizon, dataComplete])
  @@index([dataComplete, horizon, evaluatedAt])
  @@map("signal_outcomes")
}

model SignalGenerationRun {
  id                            String         @id @default(cuid())
  region                        String
  assetType                     String
  requestedByUserId             String
  status                        String
  modelVersion                  String
  rulesetVersion                String
  sourceDataDate                DateTime?
  generatedDate                 DateTime
  batchSize                     Int
  offset                        Int
  totalCount                    Int            @default(0)
  processedCount                Int            @default(0)
  generatedCount                Int            @default(0)
  updatedCount                  Int            @default(0)
  noOpCount                     Int            @default(0)
  duplicateOrIdempotentCount    Int            @default(0)
  skippedCount                  Int            @default(0)
  failedCount                   Int            @default(0)
  excludedByDataQuality         Int            @default(0)
  missingQualityEvaluationCount Int            @default(0)
  durationMs                    Int            @default(0)
  warnings                      Json
  startedAt                     DateTime       @default(now())
  completedAt                   DateTime?
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
  signalResults                 SignalResult[]

  @@index([region, assetType, modelVersion, generatedDate])
  @@index([status, startedAt])
  @@map("signal_generation_runs")
}

model SignalCalibrationResult {
  id                      String   @id @default(cuid())
  signalResultId          String
  instrumentId            String
  symbol                  String
  companyName             String?
  sector                  String?
  country                 String?
  rawScore                Float
  calibratedScore         Float
  scoreDelta              Float
  rawDirection            String
  calibratedDirection     String
  rawConfidence           String
  calibratedConfidence    String
  boosts                  Json
  penalties               Json
  calibrationReasons      Json
  dataGaps                Json
  calibrationModelVersion String
  rawSignalModelVersion   String?
  generatedAt             DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([signalResultId, calibrationModelVersion])
  @@index([instrumentId, generatedAt])
  @@index([calibratedDirection, calibratedScore])
  @@index([sector])
  @@index([country])
  @@map("signal_calibration_results")
}

model DataQualityEvaluation {
  id                     String   @id @default(cuid())
  instrumentId           String   @unique
  stock                  Stock    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol                 String
  companyName            String?
  sector                 String?
  industry               String?
  country                String?
  currency               String?
  coverageScore          Float
  coverageStatus         String
  signalReadinessScore   Float
  signalReadinessStatus  String
  liquidityScore         Float
  liquidityStatus        String
  eligibleForSignals     Boolean
  eligibleForBacktesting Boolean
  eligibleForCalibration Boolean
  dataGaps               Json
  warnings               Json
  readinessReasons       Json
  readinessBlockers      Json
  evaluatedAt            DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([coverageStatus])
  @@index([signalReadinessStatus])
  @@index([liquidityStatus])
  @@index([sector])
  @@index([country])
  @@index([evaluatedAt])
  @@map("data_quality_evaluations")
}

model Fundamental {
  id                   String    @id @default(cuid())
  stockId              String
  stock                Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  revenue              Decimal?
  eps                  Decimal?
  netIncome            Decimal?
  peRatio              Decimal?
  dividendYield        Decimal?
  sharesOutstanding    BigInt?
  marketCap            Decimal?
  currency             String?
  periodType           String
  periodEndDate        DateTime
  /// Official NSE board-meeting / result-announcement date for this period.
  /// Populated by the ingest-nse-earnings-dates script. When set, the
  /// earnings-intelligence pipeline resolves resultDateSource='OFFICIAL_CALENDAR',
  /// which unlocks RESULT_WINNERS, RESULT_DISAPPOINTMENTS, and RESULT_REACTION_HISTORY.
  officialResultDate   DateTime?
  source               String
  sourceNote           String?
  sourceUrl            String?
  validatedBy          String?
  validatedAt          DateTime?
  ingestionTimestamp   DateTime  @default(now())
  lastUpdatedTimestamp DateTime  @updatedAt
  dataStatus           String    @default("PARTIAL")

  @@unique([stockId, periodType, periodEndDate, source])
  @@index([stockId, periodEndDate])
  @@index([stockId, officialResultDate], map: "fundamentals_stockId_officialResultDate_idx")
  @@map("fundamentals")
}

model CorporateAction {
  id                   String    @id @default(cuid())
  stockId              String
  stock                Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  actionType           String
  effectiveDate        DateTime
  declaredDate         DateTime?
  paymentDate          DateTime?
  amount               Decimal?
  splitRatio           Decimal?
  currency             String?
  source               String
  naturalKey           String    @unique
  ingestionTimestamp   DateTime  @default(now())
  lastUpdatedTimestamp DateTime  @updatedAt
  dataStatus           String    @default("COMPLETE")

  @@index([stockId, effectiveDate])
  @@map("corporate_actions")
}

model FxRate {
  id                   String   @id @default(cuid())
  pair                 String   @unique
  baseCurrency         String
  quoteCurrency        String
  rate                 Decimal
  rateTimestamp        DateTime
  source               String
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("COMPLETE")

  @@index([baseCurrency, quoteCurrency])
  @@map("fx_rates")
}

model Portfolio {
  id           String                 @id @default(cuid())
  userId       String?
  user         AppUser?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  baseCurrency String
  description  String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  holdings     PortfolioHolding[]
  transactions PortfolioTransaction[]
  alertRules   AlertRule[]
  alertEvents  AlertEvent[]

  @@index([userId])
  @@map("portfolios")
}

model PortfolioHolding {
  id           String    @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrumentId String
  stock        Stock     @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol       String
  companyName  String?
  quantity     Decimal
  averageCost  Decimal
  currency     String
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([portfolioId, instrumentId])
  @@index([portfolioId])
  @@index([instrumentId])
  @@map("portfolio_holdings")
}

model PortfolioTransaction {
  id              String    @id @default(cuid())
  portfolioId     String
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrumentId    String?
  stock           Stock?    @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  type            String
  quantity        Decimal?
  price           Decimal?
  amount          Decimal?
  currency        String
  transactionDate DateTime
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([portfolioId, transactionDate])
  @@index([instrumentId])
  @@map("portfolio_transactions")
}

model Watchlist {
  id          String          @id @default(cuid())
  userId      String?
  user        AppUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       WatchlistItem[]
  alertRules  AlertRule[]
  alertEvents AlertEvent[]

  @@index([userId])
  @@map("watchlists")
}

model AlertRule {
  id                    String       @id @default(cuid())
  userId                String?
  user                  AppUser?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                  String
  type                  String
  scope                 String
  instrumentId          String?
  stock                 Stock?       @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  portfolioId           String?
  portfolio             Portfolio?   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  watchlistId           String?
  watchlist             Watchlist?   @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  condition             Json
  enabled               Boolean      @default(true)
  lastObservedDirection String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  events                AlertEvent[]

  @@index([userId])
  @@index([type, scope])
  @@index([enabled])
  @@index([instrumentId])
  @@index([portfolioId])
  @@index([watchlistId])
  @@map("alert_rules")
}

model AlertEvent {
  id           String     @id @default(cuid())
  alertRuleId  String
  alertRule    AlertRule  @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  type         String
  severity     String
  title        String
  message      String
  instrumentId String?
  stock        Stock?     @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  portfolioId  String?
  portfolio    Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  watchlistId  String?
  watchlist    Watchlist? @relation(fields: [watchlistId], references: [id], onDelete: SetNull)
  metadata     Json
  triggeredAt  DateTime   @default(now())
  readAt       DateTime?
  dismissedAt  DateTime?

  @@index([alertRuleId, triggeredAt])
  @@index([readAt])
  @@index([dismissedAt])
  @@map("alert_events")
}

model BacktestStrategy {
  id          String        @id @default(cuid())
  userId      String?
  user        AppUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  description String?
  config      Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        BacktestRun[]

  @@index([userId])
  @@map("backtest_strategies")
}

model BacktestRun {
  id          String            @id @default(cuid())
  userId      String?
  user        AppUser?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  strategyId  String?
  strategy    BacktestStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  config      Json
  status      String
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  metrics     Json?
  equityCurve Json?
  trades      Json?
  error       String?

  @@index([userId])
  @@index([strategyId])
  @@index([startedAt])
  @@map("backtest_runs")
}

model AppUser {
  id                      String                  @id @default(cuid())
  email                   String?                 @unique
  displayName             String?
  passwordHash            String?
  lastLoginAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  subscription            UserSubscription?
  usageCounters           UsageCounter[]
  portfolios              Portfolio[]
  watchlists              Watchlist[]
  alertRules              AlertRule[]
  backtestRuns            BacktestRun[]
  backtestStrategies      BacktestStrategy[]
  notificationPreferences NotificationPreference?
  notificationEvents      NotificationEvent[]
  tradeJournalEntries     TradeJournalEntry[]

  @@map("app_users")
}

model TradeJournalEntry {
  id                String    @id @default(cuid())
  userId            String
  user              AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId      String? // optional FK to stocks.id — not enforced at DB level to allow deleted/delisted instruments
  symbol            String // NSE/BSE symbol snapshot, normalized uppercase
  sourceSignalId    String? // optional: the SignalResult id that prompted this review
  direction         String // LONG | SHORT
  decision          String // ACTED | SKIPPED | WATCHING
  reviewedAt        DateTime // when the human reviewed this signal/opportunity
  entryPrice        Decimal? // price at which position was entered (ACTED entries)
  stopPrice         Decimal? // planned stop loss price
  targetPrice       Decimal? // planned target price
  thesis            String? // free-text rationale
  conviction        Decimal? // 1–10 self-rated conviction at time of decision
  outcomeStatus     String? // OPEN | CLOSED | INVALIDATED | null
  exitPrice         Decimal? // price at which position was exited
  exitAt            DateTime? // when the position was exited
  realizedReturnPct Decimal? // computed: LONG=(exit-entry)/entry; SHORT=(entry-exit)/entry
  notes             String? // free-text post-mortem notes
  tags              Json? // string[] — user-defined labels
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([userId, reviewedAt])
  @@index([instrumentId])
  @@map("trade_journal_entries")
}

model NotificationPreference {
  id                        String   @id @default(cuid())
  userId                    String   @unique
