datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

model PriceTick {
  id                   String   @id @default(cuid())
  symbol               String
  region               String? // e.g., "US", "EU", "ASIA"
  exchange             String? // e.g., "NASDAQ", "NYSE"
  timestamp            DateTime
  open                 Decimal
  high                 Decimal
  low                  Decimal
  close                Decimal
  adjustedClose        Decimal?
  volume               BigInt?
  source               String? // e.g., "yahoo", "coinbase"
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("COMPLETE")

  @@unique([symbol, timestamp])
  @@index([symbol, timestamp])
  @@index([region])
  @@map("price_ticks")
}

model LatestPrice {
  symbol    String   @id
  region    String? // region for filtering
  price     Decimal
  timestamp DateTime
  updatedAt DateTime @updatedAt

  @@map("latest_prices")
}

model Stock {
  id                           String   @id @default(cuid())
  symbol                       String   @unique
  name                         String
  region                       String   // IN, US, EU, UK, CN
  exchange                     String?
  country                      String?
  sector                       String?
  industry                     String?
  currency                     String?
  marketCap                    Decimal?
  assetType                    String?
  isDelisted                   Boolean  @default(false)
  ipoDate                      DateTime?
  isin                         String?
  source                       String   @default("database")
  dataStatus                   String   @default("PARTIAL")
  isActive                     Boolean  @default(true)
  lastSuccessfulDataLoadTimestamp DateTime?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  fundamentals                 Fundamental[]
  corporateActions             CorporateAction[]
  signalResults                SignalResult[]
  portfolioHoldings            PortfolioHolding[]
  portfolioTransactions        PortfolioTransaction[]
  watchlistItems                WatchlistItem[]
  alertRules                    AlertRule[]
  alertEvents                   AlertEvent[]

  @@map("stocks")
}

model SignalResult {
  id               String   @id @default(cuid())
  instrumentId     String
  stock            Stock    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol           String
  companyName      String?
  sector           String?
  country          String?
  score            Float
  direction        String
  confidence       String
  triggeredSignals Json
  negativeSignals  Json
  explanation      String
  generatedAt      DateTime @default(now())
  source           String   @default("signal-generation-engine")
  dataStatus       String   @default("PARTIAL")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([instrumentId, generatedAt])
  @@index([direction, score])
  @@index([sector])
  @@index([country])
  @@map("signal_results")
}

model Fundamental {
  id                   String   @id @default(cuid())
  stockId              String
  stock                Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  revenue              Decimal?
  eps                  Decimal?
  netIncome            Decimal?
  peRatio              Decimal?
  dividendYield        Decimal?
  sharesOutstanding    BigInt?
  marketCap            Decimal?
  currency             String?
  periodType           String
  periodEndDate        DateTime
  source               String
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("PARTIAL")

  @@unique([stockId, periodType, periodEndDate, source])
  @@index([stockId, periodEndDate])
  @@map("fundamentals")
}

model CorporateAction {
  id                   String   @id @default(cuid())
  stockId              String
  stock                Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  actionType           String
  effectiveDate        DateTime
  declaredDate         DateTime?
  paymentDate          DateTime?
  amount               Decimal?
  splitRatio           Decimal?
  currency             String?
  source               String
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("COMPLETE")

  @@unique([stockId, actionType, effectiveDate, source])
  @@index([stockId, effectiveDate])
  @@map("corporate_actions")
}

model FxRate {
  id                   String   @id @default(cuid())
  pair                 String   @unique
  baseCurrency         String
  quoteCurrency        String
  rate                 Decimal
  rateTimestamp        DateTime
  source               String
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("COMPLETE")

  @@index([baseCurrency, quoteCurrency])
  @@map("fx_rates")
}

model Portfolio {
  id           String                 @id @default(cuid())
  userId       String?
  user         AppUser?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  baseCurrency String
  description  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  holdings     PortfolioHolding[]
  transactions PortfolioTransaction[]
  alertRules   AlertRule[]
  alertEvents  AlertEvent[]

  @@index([userId])
  @@map("portfolios")
}

model PortfolioHolding {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrumentId String
  stock       Stock     @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol      String
  companyName String?
  quantity    Decimal
  averageCost Decimal
  currency    String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([portfolioId, instrumentId])
  @@index([portfolioId])
  @@index([instrumentId])
  @@map("portfolio_holdings")
}

model PortfolioTransaction {
  id              String    @id @default(cuid())
  portfolioId     String
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrumentId    String?
  stock           Stock?    @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  type            String
  quantity        Decimal?
  price           Decimal?
  amount          Decimal?
  currency        String
  transactionDate DateTime
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([portfolioId, transactionDate])
  @@index([instrumentId])
  @@map("portfolio_transactions")
}

model Watchlist {
  id          String          @id @default(cuid())
  userId      String?
  user        AppUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       WatchlistItem[]
  alertRules  AlertRule[]
  alertEvents AlertEvent[]

  @@index([userId])
  @@map("watchlists")
}

model AlertRule {
  id          String       @id @default(cuid())
  userId      String?
  user        AppUser?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  type        String
  scope       String
  instrumentId String?
  stock       Stock?       @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  portfolioId String?
  portfolio   Portfolio?   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  watchlistId String?
  watchlist   Watchlist?   @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  condition   Json
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  events      AlertEvent[]

  @@index([userId])
  @@index([type, scope])
  @@index([enabled])
  @@index([instrumentId])
  @@index([portfolioId])
  @@index([watchlistId])
  @@map("alert_rules")
}

model AlertEvent {
  id            String     @id @default(cuid())
  alertRuleId   String
  alertRule     AlertRule  @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  type          String
  severity      String
  title         String
  message       String
  instrumentId  String?
  stock         Stock?      @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  portfolioId   String?
  portfolio     Portfolio?  @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  watchlistId   String?
  watchlist     Watchlist?  @relation(fields: [watchlistId], references: [id], onDelete: SetNull)
  metadata      Json
  triggeredAt   DateTime    @default(now())
  readAt        DateTime?
  dismissedAt   DateTime?

  @@index([alertRuleId, triggeredAt])
  @@index([readAt])
  @@index([dismissedAt])
  @@map("alert_events")
}

model BacktestStrategy {
  id          String        @id @default(cuid())
  userId      String?
  user        AppUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  description String?
  config      Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        BacktestRun[]

  @@index([userId])
  @@map("backtest_strategies")
}

model BacktestRun {
  id           String            @id @default(cuid())
  userId       String?
  user         AppUser?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  strategyId   String?
  strategy     BacktestStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  config       Json
  status       String
  startedAt    DateTime          @default(now())
  completedAt  DateTime?
  metrics      Json?
  equityCurve  Json?
  trades       Json?
  error        String?

  @@index([userId])
  @@index([strategyId])
  @@index([startedAt])
  @@map("backtest_runs")
}

model AppUser {
  id              String             @id @default(cuid())
  email           String?            @unique
  displayName     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  subscription    UserSubscription?
  usageCounters   UsageCounter[]
  portfolios      Portfolio[]
  watchlists      Watchlist[]
  alertRules      AlertRule[]
  backtestRuns    BacktestRun[]
  backtestStrategies BacktestStrategy[]

  @@map("app_users")
}

model SubscriptionPlan {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

model UserSubscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode  String
  status    String
  startedAt DateTime @default(now())
  expiresAt DateTime?
  updatedAt DateTime @updatedAt

  @@index([planCode])
  @@map("user_subscriptions")
}

model UsageCounter {
  id          String   @id @default(cuid())
  userId      String
  user        AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  period      String
  periodStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, key, periodStart])
  @@index([key, periodStart])
  @@map("usage_counters")
}

model WatchlistItem {
  id           String    @id @default(cuid())
  watchlistId  String
  watchlist    Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  instrumentId String
  stock        Stock     @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol       String
  companyName  String?
  notes        String?
  tags         Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([watchlistId, instrumentId])
  @@index([watchlistId])
  @@index([instrumentId])
  @@map("watchlist_items")
}






