  scanType    String
  /// e.g. '1D' | '1W' | '1M' | '3M' | '6M' | '1Y'  (NULL for non-mover scans)
  scanRange   String?
  region      String
  assetType   String
  tradingDate DateTime
  /// 1-based rank within scanType+scanRange+region+assetType+tradingDate
  rank        Int
  /// Full row payload as stored by the refresh pipeline; shape varies by scanType
  payloadJson Json
  computedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scanType, scanRange, region, assetType, tradingDate, rank], map: "market_scan_snapshot_type_range_scope_date_rank_key")
  @@index([scanType, scanRange, region, assetType, tradingDate], map: "market_scan_snapshot_lookup_idx")
  @@index([tradingDate, region, assetType], map: "market_scan_snapshot_date_scope_idx")
  @@map("market_scan_snapshots")
}

// ===========================================================================
// CRYPTO MARKET DATA — physically isolated storage (crypto_* tables)
// ---------------------------------------------------------------------------
// Crypto market data lives in its own table family so high-volume multi-market
// data never co-mingles with the equity tables (stocks/price_ticks/...).  Domain
// COMPUTE is shared (pure functions); only PERSISTENCE is routed by asset class.
// These mirror their equity counterparts' fields so routed repositories can reuse
// the same row-shaping logic; crypto rows FK into crypto_assets (never stocks).
// Equity-only concepts (fundamentals, delivery, corporate actions, smart money,
// earnings, sector/market-pulse) are intentionally NOT modelled here — those
// features degrade for crypto via MarketProfile capability flags.
// Low-volume orchestration metadata (pipeline_runs, pipeline_stage_runs,
// market_data_sync_states) stays SHARED, discriminated by scopeAssetType=CRYPTO.
// ===========================================================================

model CryptoAsset {
  id                              String                        @id @default(cuid())
  symbol                          String                        @unique // Binance pair, e.g. BTCUSDT
  name                            String
  region                          String                        @default("GLOBAL")
  exchange                        String?                       @default("CRYPTO")
  currency                        String?                       @default("USD")
  marketCap                       Decimal?
  rank                            Int? // market-cap rank (1..N) from the universe source
  assetType                       String?                       @default("CRYPTO")
  instrumentSegment               String?                       @default("CRYPTO")
  displaySymbol                   String? // BTC
  providerSymbol                  String? // Binance pair symbol (BTCUSDT)
  sourceSymbol                    String? // universe-source id (CoinPaprika "btc-bitcoin")
  catalogSource                   String?
  providerSupportStatus           String?
  providerError                   String?
  isDelisted                      Boolean                       @default(false)
  source                          String                        @default("database")
  dataStatus                      String                        @default("PARTIAL")
  isActive                        Boolean                       @default(true)
  lastSuccessfulDataLoadTimestamp DateTime?
  // ── Descriptive metadata (CoinPaprika /coins/{id} + /tickers) ───────────────
  description                     String?                       @db.Text
  logoUrl                         String?
  websiteUrl                      String?
  categoryTags                    String[] // e.g. ["smart-contract-platform","defi"]
  circulatingSupply               Decimal?
  totalSupply                     Decimal?
  maxSupply                       Decimal?
  fullyDilutedValuation           Decimal?
  athPrice                        Decimal?
  athDate                         DateTime?
  atlPrice                        Decimal?
  atlDate                         DateTime?
  genesisDate                     DateTime?
  contractAddresses               Json? // { chain: address } across networks
  metadataSource                  String?
  metadataUpdatedAt               DateTime?
  createdAt                       DateTime                      @default(now())
  updatedAt                       DateTime                      @updatedAt
  signalResults                   CryptoSignalResult[]
  dataQualityEvaluations          CryptoDataQualityEvaluation[]
  interestSnapshots               CryptoInterestSnapshot[]
  fundamentalSnapshots            CryptoFundamentalSnapshot[]
  events                          CryptoEvent[]
  futuresSnapshots                CryptoFuturesSnapshot[]
  dailyMetricSnapshots            CryptoDailyMetricSnapshot[]

  @@index([region, assetType, symbol], map: "crypto_assets_region_assetType_symbol_idx")
  @@index([rank], map: "crypto_assets_rank_idx")
  @@index([providerSupportStatus, isActive, isDelisted], map: "crypto_assets_support_active_delisted_idx")
  @@map("crypto_assets")
}

// On-chain / protocol fundamentals (DefiLlama, free + commercial-OK). Coverage is
// partial by nature — only DeFi protocols have TVL/fees/revenue; non-DeFi coins get
// a row with coverageStatus=NONE so the gap is explicit rather than silently missing.
model CryptoFundamentalSnapshot {
  id                   String      @id @default(cuid())
  instrumentId         String
  asset                CryptoAsset @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol               String // BTCUSDT
  snapshotDate         DateTime // UTC day of the snapshot
  defillamaSlug        String?
  category             String? // DeFi category (DEX, Lending, …)
  chains               Json? // chains the protocol is deployed on
  tvlUsd               Decimal?
  tvlChange1dPct       Float?
  tvlChange7dPct       Float?
  fees24hUsd           Decimal?
  fees7dUsd            Decimal?
  revenue24hUsd        Decimal?
  revenue30dUsd        Decimal?
  annualizedRevenueUsd Decimal?
  stakingApyPct        Float?
  coverageStatus       String      @default("NONE") // FULL / PARTIAL / NONE
  source               String      @default("DEFILLAMA")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([instrumentId, snapshotDate])
  @@index([symbol, snapshotDate])
  @@index([snapshotDate])
  @@map("crypto_fundamental_snapshots")
}

// Perpetual-futures market structure (Binance USDⓈ-M futures, free/keyless): funding
// rate (sentiment/positioning) + open interest. Per-asset daily snapshot. Only assets
// with a tradable perp get a row; spot-only coins are simply absent.
model CryptoFuturesSnapshot {
  id              String      @id @default(cuid())
  instrumentId    String
  asset           CryptoAsset @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol          String // perp symbol, e.g. BTCUSDT
  snapshotDate    DateTime // UTC day of the snapshot
  fundingRatePct  Float? // last funding rate as a percent (e.g. 0.01 = 0.01%/8h)
  openInterestUsd Decimal? // notional open interest in USD
  longShortRatioGlobal      Float?
  longAccountPct            Float?
  shortAccountPct           Float?
  topTraderLongShortRatio   Float?
  topTraderPositionRatio    Float?
  takerBuySellRatio         Float?
  source          String      @default("BINANCE_FUTURES")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([instrumentId, snapshotDate])
  @@index([symbol, snapshotDate])
  @@index([snapshotDate])
  @@map("crypto_futures_snapshots")
}

// Denormalized per-asset daily bull/bear metrics — the single read source for the
// crypto signal board and instrument workspace. Every value is COMPUTED BY THE PIPELINE
// (CRYPTO_DAILY_METRICS stage) and stored here; the frontend does no runtime calculation.
model CryptoDailyMetricSnapshot {
  id                 String      @id @default(cuid())
  instrumentId       String
  asset              CryptoAsset @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol             String
  name               String?
  snapshotDate       DateTime // UTC day of the snapshot
  dataThroughDate    DateTime? // latest price date the metrics were computed from
  // Price / catalog
  price              Decimal?
  marketCap          Decimal?
  rank               Int?
  // Signal (mirrored from crypto_signal_results for single-query board reads)
  signalScore        Float?
  signalDirection    String? // BULLISH / NEUTRAL / BEARISH
  signalConfidence   String? // HIGH / MEDIUM / LOW
  // Bull/bear flags & momentum
  volumeSpike        Boolean     @default(false)
  pctChange1d        Float?
  pctChange7d        Float?
  pctChange30d       Float?
  distanceFromAthPct Float? // negative = below ATH
  near52wHigh        Boolean     @default(false)
  near52wLow         Boolean     @default(false)
  // Technical indicators (computed once here, persisted)
  rsi14              Float?
  macd               Float?
  macdSignal         Float?
  macdHist           Float?
  bbPercentB         Float?
  sma50              Float?
  sma200             Float?
  crossState         String? // GOLDEN / DEATH / NONE
  rsVsBtcPct         Float? // relative strength vs BTC over the lookback
  // Fundamentals / futures (mirrored for board columns; null when not covered)
  tvlUsd             Decimal?
  tvlChange7dPct     Float?
  fundingRatePct     Float?
  openInterestUsd    Decimal?
  quoteVolume24h     Decimal?
  calculationVersion String      @default("crypto-metrics-v1")
  dataStatus         String      @default("COMPLETE")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([instrumentId, snapshotDate])
  @@index([snapshotDate, signalDirection, signalScore])
  @@index([snapshotDate, volumeSpike])
  @@index([snapshotDate, rank])
  @@map("crypto_daily_metric_snapshots")
}

// Upcoming/!past events (CoinMarketCal free tier): token unlocks, mainnet upgrades,
// exchange listings, governance votes, airdrops. instrumentId nullable for events
// that don't map to a tracked coin. Dormant until CRYPTO_COINMARKETCAL_API_KEY is set.
model CryptoEvent {
  id               String       @id @default(cuid())
  instrumentId     String?
  asset            CryptoAsset? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  symbol           String? // base ticker or pair
  source           String       @default("COINMARKETCAL")
  externalId       String // provider event id
  title            String
  description      String?      @db.Text
  category         String? // UNLOCK / UPGRADE / LISTING / GOVERNANCE / AIRDROP / OTHER
  eventDate        DateTime
  dateConfidence   String? // CONFIRMED / ESTIMATED
  isHot            Boolean      @default(false)
  percentageChange Float?
  votes            Int?
  proofUrl         String?
  sourceUrl        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([source, externalId])
  @@index([eventDate])
  @@index([instrumentId, eventDate])
  @@index([category, eventDate])
  @@map("crypto_events")
}

model CryptoPriceTick {
  id                   String   @id @default(cuid())
