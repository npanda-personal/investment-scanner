datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

model PriceTick {
  id                   String   @id @default(cuid())
  symbol               String
  region               String? // e.g., "US", "EU", "ASIA"
  exchange             String? // e.g., "NASDAQ", "NYSE"
  timestamp            DateTime
  open                 Decimal
  high                 Decimal
  low                  Decimal
  close                Decimal
  adjustedClose        Decimal?
  volume               BigInt?
  source               String? // e.g., "yahoo", "coinbase"
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("COMPLETE")

  @@unique([symbol, timestamp])
  @@index([symbol, timestamp])
  @@index([region])
  @@map("price_ticks")
}

model LatestPrice {
  symbol    String   @id
  region    String? // region for filtering
  price     Decimal
  timestamp DateTime
  updatedAt DateTime @updatedAt

  @@map("latest_prices")
}

model Stock {
  id                           String   @id @default(cuid())
  symbol                       String   @unique
  name                         String
  region                       String   // IN, US, EU, UK, CN
  exchange                     String?
  country                      String?
  sector                       String?
  industry                     String?
  currency                     String?
  marketCap                    Decimal?
  assetType                    String?
  instrumentSegment            String?
  displaySymbol                String?
  providerSymbol               String?
  sourceSymbol                 String?
  catalogSource                String?
  providerSupportStatus        String?
  providerError                String?
  derivativesEligible          Boolean  @default(false)
  underlyingSymbol             String?
  expiryDate                   DateTime?
  contractMonth                String?
  lotSize                      Int?
  contractStatus               String?
  isDelisted                   Boolean  @default(false)
  ipoDate                      DateTime?
  isin                         String?
  source                       String   @default("database")
  dataStatus                   String   @default("PARTIAL")
  isActive                     Boolean  @default(true)
  lastSuccessfulDataLoadTimestamp DateTime?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  fundamentals                 Fundamental[]
  corporateActions             CorporateAction[]
  signalResults                SignalResult[]
  dataQualityEvaluations       DataQualityEvaluation[]
  portfolioHoldings            PortfolioHolding[]
  portfolioTransactions        PortfolioTransaction[]
  watchlistItems                WatchlistItem[]
  alertRules                    AlertRule[]
  alertEvents                   AlertEvent[]
  smartMoneySnapshots           SmartMoneyContextSnapshot[]
  strategyDecisions             StrategyDecisionResult[]
  marketDataRepairAttempts      MarketDataRepairAttempt[]
  marketDataRepairStates        MarketDataRepairState[]

  @@index([region, assetType, symbol], map: "stocks_region_assetType_symbol_idx")
  @@index([region, assetType, providerSupportStatus, isActive, isDelisted], map: "stocks_region_assetType_providerSupport_active_delisted_idx")
  @@map("stocks")
}

model MarketDataRepairAttempt {
  id                   String   @id @default(cuid())
  stockId              String
  stock                Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  region               String
  assetType            String?
  repairType           String
  status               String
  provider             String?
  attemptedAt          DateTime @default(now())
  completedAt          DateTime?
  fieldsFilledJson     Json?
  error                String?
  manualRequiredReason String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([stockId, repairType, status, attemptedAt])
  @@index([region, assetType, repairType, status])
  @@map("market_data_repair_attempts")
}

model MarketDataRepairState {
  id                   String   @id @default(cuid())
  stockId              String
  stock                Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  region               String
  assetType            String?
  repairType           String
  status               String
  provider             String?
  lastAttemptId        String?
  fieldsFilledJson     Json?
  error                String?
  manualRequiredReason String?
  nextRetryAt          DateTime?
  firstDetectedAt      DateTime @default(now())
  lastAttemptedAt      DateTime?
  resolvedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([stockId, repairType])
  @@index([region, assetType, repairType, status])
  @@index([repairType, status, nextRetryAt])
  @@map("market_data_repair_states")
}

model MarketDataRepairRun {
  id                   String    @id @default(cuid())
  region               String
  assetType            String?
  status               String
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  beforeHealthJson     Json?
  afterHealthJson      Json?
  beforeRepairPlanJson Json?
  afterRepairPlanJson  Json?
  actionsJson          Json
  summaryJson          Json?
  warningsJson         Json?
  error                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([region, assetType, status, startedAt])
  @@map("market_data_repair_runs")
}

model SignalResult {
  id               String   @id @default(cuid())
  instrumentId     String
  stock            Stock    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  generationRunId  String?
  generationRun    SignalGenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  symbol           String
  companyName      String?
  sector           String?
  country          String?
  score            Float
  direction        String
  confidence       String
  triggeredSignals Json
  negativeSignals  Json
  explanation      String
  generatedAt      DateTime @default(now())
  generatedDate    DateTime?
  modelVersion     String   @default("signal-engine-v1")
  rulesetVersion   String?
  sourceDataDate   DateTime?
  sourcePriceDate  DateTime?
  scoringInputSummary Json?
  dataQualityEligibilitySnapshot Json?
  source           String   @default("signal-generation-engine")
  dataStatus       String   @default("PARTIAL")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([instrumentId, modelVersion, generatedDate])
  @@index([generationRunId])
  @@index([modelVersion, sourceDataDate])
  @@index([instrumentId, generatedAt])
  @@index([direction, score])
  @@index([sector])
  @@index([country])
  @@map("signal_results")
}

model SignalGenerationRun {
  id                             String   @id @default(cuid())
  region                         String
  assetType                      String
  requestedByUserId              String
  status                         String
  modelVersion                   String
  rulesetVersion                 String
  sourceDataDate                 DateTime?
  generatedDate                  DateTime
  batchSize                      Int
  offset                         Int
  totalCount                     Int       @default(0)
  processedCount                 Int       @default(0)
  generatedCount                 Int       @default(0)
  updatedCount                   Int       @default(0)
  noOpCount                      Int       @default(0)
  duplicateOrIdempotentCount     Int       @default(0)
  skippedCount                   Int       @default(0)
  failedCount                    Int       @default(0)
  excludedByDataQuality          Int       @default(0)
  missingQualityEvaluationCount  Int       @default(0)
  durationMs                     Int       @default(0)
  warnings                       Json
  startedAt                      DateTime  @default(now())
  completedAt                    DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  signalResults                  SignalResult[]

  @@index([region, assetType, modelVersion, generatedDate])
  @@index([status, startedAt])
  @@map("signal_generation_runs")
}

model SignalCalibrationResult {
  id                       String   @id @default(cuid())
  signalResultId           String
  instrumentId             String
  symbol                   String
  companyName              String?
  sector                   String?
  country                  String?
  rawScore                 Float
  calibratedScore          Float
  scoreDelta               Float
  rawDirection             String
  calibratedDirection      String
  rawConfidence            String
  calibratedConfidence     String
  boosts                   Json
  penalties                Json
  calibrationReasons       Json
  dataGaps                 Json
  calibrationModelVersion  String
  rawSignalModelVersion    String?
  generatedAt              DateTime @default(now())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([signalResultId, calibrationModelVersion])
  @@index([instrumentId, generatedAt])
  @@index([calibratedDirection, calibratedScore])
  @@index([sector])
  @@index([country])
  @@map("signal_calibration_results")
}

model DataQualityEvaluation {
  id                    String   @id @default(cuid())
  instrumentId          String   @unique
  stock                 Stock    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol                String
  companyName           String?
  sector                String?
  industry              String?
  country               String?
  currency              String?
  coverageScore         Float
  coverageStatus        String
  signalReadinessScore  Float
  signalReadinessStatus String
  liquidityScore        Float
  liquidityStatus       String
  eligibleForSignals    Boolean
  eligibleForBacktesting Boolean
  eligibleForCalibration Boolean
  dataGaps              Json
  warnings              Json
  readinessReasons      Json
  readinessBlockers     Json
  evaluatedAt           DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([coverageStatus])
  @@index([signalReadinessStatus])
  @@index([liquidityStatus])
  @@index([sector])
  @@index([country])
  @@index([evaluatedAt])
  @@map("data_quality_evaluations")
}

model Fundamental {
  id                   String   @id @default(cuid())
  stockId              String
  stock                Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  revenue              Decimal?
  eps                  Decimal?
  netIncome            Decimal?
  peRatio              Decimal?
  dividendYield        Decimal?
  sharesOutstanding    BigInt?
  marketCap            Decimal?
  currency             String?
  periodType           String
  periodEndDate        DateTime
  source               String
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("PARTIAL")

  @@unique([stockId, periodType, source])
  @@index([stockId, periodEndDate])
  @@map("fundamentals")
}

model CorporateAction {
  id                   String   @id @default(cuid())
  stockId              String
  stock                Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  actionType           String
  effectiveDate        DateTime
  declaredDate         DateTime?
  paymentDate          DateTime?
  amount               Decimal?
  splitRatio           Decimal?
  currency             String?
  source               String
  naturalKey           String   @unique
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("COMPLETE")

  @@index([stockId, effectiveDate])
  @@map("corporate_actions")
}

model FxRate {
  id                   String   @id @default(cuid())
  pair                 String   @unique
  baseCurrency         String
  quoteCurrency        String
  rate                 Decimal
  rateTimestamp        DateTime
  source               String
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("COMPLETE")

  @@index([baseCurrency, quoteCurrency])
  @@map("fx_rates")
}

model Portfolio {
  id           String                 @id @default(cuid())
  userId       String?
  user         AppUser?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  baseCurrency String
  description  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  holdings     PortfolioHolding[]
  transactions PortfolioTransaction[]
  alertRules   AlertRule[]
  alertEvents  AlertEvent[]

  @@index([userId])
  @@map("portfolios")
}

model PortfolioHolding {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrumentId String
  stock       Stock     @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol      String
  companyName String?
  quantity    Decimal
  averageCost Decimal
  currency    String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([portfolioId, instrumentId])
  @@index([portfolioId])
  @@index([instrumentId])
  @@map("portfolio_holdings")
}

model PortfolioTransaction {
  id              String    @id @default(cuid())
  portfolioId     String
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrumentId    String?
  stock           Stock?    @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  type            String
  quantity        Decimal?
  price           Decimal?
  amount          Decimal?
  currency        String
  transactionDate DateTime
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([portfolioId, transactionDate])
  @@index([instrumentId])
  @@map("portfolio_transactions")
}

model Watchlist {
  id          String          @id @default(cuid())
  userId      String?
  user        AppUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       WatchlistItem[]
  alertRules  AlertRule[]
  alertEvents AlertEvent[]

  @@index([userId])
  @@map("watchlists")
}

model AlertRule {
  id          String       @id @default(cuid())
  userId      String?
  user        AppUser?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  type        String
  scope       String
  instrumentId String?
  stock       Stock?       @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  portfolioId String?
  portfolio   Portfolio?   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  watchlistId String?
  watchlist   Watchlist?   @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  condition   Json
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  events      AlertEvent[]

  @@index([userId])
  @@index([type, scope])
  @@index([enabled])
  @@index([instrumentId])
  @@index([portfolioId])
  @@index([watchlistId])
  @@map("alert_rules")
}

model AlertEvent {
  id            String     @id @default(cuid())
  alertRuleId   String
  alertRule     AlertRule  @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  type          String
  severity      String
  title         String
  message       String
  instrumentId  String?
  stock         Stock?      @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  portfolioId   String?
  portfolio     Portfolio?  @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  watchlistId   String?
  watchlist     Watchlist?  @relation(fields: [watchlistId], references: [id], onDelete: SetNull)
  metadata      Json
  triggeredAt   DateTime    @default(now())
  readAt        DateTime?
  dismissedAt   DateTime?

  @@index([alertRuleId, triggeredAt])
  @@index([readAt])
  @@index([dismissedAt])
  @@map("alert_events")
}

model BacktestStrategy {
  id          String        @id @default(cuid())
  userId      String?
  user        AppUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  description String?
  config      Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        BacktestRun[]

  @@index([userId])
  @@map("backtest_strategies")
}

model BacktestRun {
  id           String            @id @default(cuid())
  userId       String?
  user         AppUser?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  strategyId   String?
  strategy     BacktestStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  config       Json
  status       String
  startedAt    DateTime          @default(now())
  completedAt  DateTime?
  metrics      Json?
  equityCurve  Json?
  trades       Json?
  error        String?

  @@index([userId])
  @@index([strategyId])
  @@index([startedAt])
  @@map("backtest_runs")
}

model AppUser {
  id              String             @id @default(cuid())
  email           String?            @unique
  displayName     String?
  passwordHash    String?
  lastLoginAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  subscription    UserSubscription?
  usageCounters   UsageCounter[]
  portfolios      Portfolio[]
  watchlists      Watchlist[]
  alertRules      AlertRule[]
  backtestRuns    BacktestRun[]
  backtestStrategies BacktestStrategy[]
  notificationPreferences NotificationPreference?
  notificationEvents NotificationEvent[]

  @@map("app_users")
}

model NotificationPreference {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  user                       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotificationsEnabled  Boolean  @default(false)
  alertEmailsEnabled         Boolean  @default(false)
  dailyDigestEnabled         Boolean  @default(false)
  weeklyDigestEnabled        Boolean  @default(false)
  quietHoursStart            String?
  quietHoursEnd              String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("notification_preferences")
}

model NotificationEvent {
  id        String   @id @default(cuid())
  userId    String
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  channel   String
  title     String
  message   String
  payload   Json
  status    String
  error     String?
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@index([userId, createdAt])
  @@index([status])
  @@map("notification_events")
}

model MarketContextSnapshot {
  id                       String   @id @default(cuid())
  snapshotDate             DateTime
  region                   String   @default("GLOBAL")
  regime                   String
  regimeScore              Float
  breadthPercentAboveSma50 Float?
  breadthPercentAboveSma200 Float?
  advanceDeclineRatio      Float?
  newHighCount             Int?
  newLowCount              Int?
  macroStatus              String?
  explanation              String?
  source                   String
  dataStatus               String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([snapshotDate, region])
  @@index([snapshotDate])
  @@map("market_context_snapshots")
}

model SectorContextSnapshot {
  id                    String   @id @default(cuid())
  snapshotDate          DateTime
  region                String   @default("GLOBAL")
  sector                String
  oneMonthReturn        Float?
  threeMonthReturn      Float?
  sixMonthReturn        Float?
  relativeStrengthScore Float
  instrumentCount       Int
  bullishSignalCount    Int?
  bearishSignalCount    Int?
  leadershipStatus      String
  source                String
  dataStatus            String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([snapshotDate, region, sector])
  @@index([snapshotDate])
  @@index([sector])
  @@map("sector_context_snapshots")
}

model CountryContextSnapshot {
  id                    String   @id @default(cuid())
  snapshotDate          DateTime
  region                String   @default("GLOBAL")
  country               String
  oneMonthReturn        Float?
  threeMonthReturn      Float?
  sixMonthReturn        Float?
  relativeStrengthScore Float
  bullishSignalCount    Int?
  bearishSignalCount    Int?
  source                String
  dataStatus            String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([snapshotDate, region, country])
  @@index([snapshotDate])
  @@index([country])
  @@map("country_context_snapshots")
}

model SmartMoneyContextSnapshot {
  id                       String   @id @default(cuid())
  snapshotDate             DateTime
  instrumentId             String
  stock                    Stock    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol                   String
  companyName              String?
  sector                   String?
  smartMoneyScore          Float
  status                   String
  confidence               String
  accumulationSignalCount  Int
  distributionSignalCount  Int
  unusualVolumeDetected    Boolean
  explanation              String?
  source                   String
  dataStatus               String
  latestClose              Float?
  latestVolume             Float?
  averageVolume20          Float?
  dailyChangePercent       Float?
  signals                  Json?
  insiderOwnership         Json?
  range                    String   @default("3M")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([snapshotDate, instrumentId, range])
  @@index([snapshotDate])
  @@index([instrumentId])
  @@index([sector])
  @@index([status, smartMoneyScore])
  @@map("smart_money_context_snapshots")
}

model DataQualitySnapshot {
  id                   String   @id @default(cuid())
  snapshotDate         DateTime
  instrumentId         String
  symbol               String
  priceHistoryDays     Int
  hasLatestPrice       Boolean
  hasFundamentals      Boolean
  hasSector            Boolean
  hasIndustry          Boolean
  dataStatus           String
  signalReadinessScore Float
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([snapshotDate, instrumentId])
  @@index([snapshotDate])
  @@index([instrumentId])
  @@map("data_quality_snapshots")
}

model MarketDataSyncState {
  id               String   @id @default(cuid())
  region           String
  assetType        String
  scopeType        String   @default("CATALOG")
  scopeKey         String   @default("DEFAULT")
  timeframe        String   @default("1D")
  tradingDate      DateTime
  status           String
  lastCheckedAt    DateTime?
  lastProviderFetchAt DateTime?
  lastRunAt        DateTime?
  lastInsertedCount Int     @default(0)
  lastUpdatedCount Int      @default(0)
  lastNoOpCount    Int      @default(0)
  lastSkippedCount Int      @default(0)
  lastWarningCount Int      @default(0)
  lastSummary      Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([region, assetType, scopeType, scopeKey, timeframe, tradingDate])
  @@index([region, assetType, scopeType, timeframe, status])
  @@map("market_data_sync_states")
}

model SubscriptionPlan {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

model UserSubscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode  String
  status    String
  startedAt DateTime @default(now())
  expiresAt DateTime?
  updatedAt DateTime @updatedAt

  @@index([planCode])
  @@map("user_subscriptions")
}

model UsageCounter {
  id          String   @id @default(cuid())
  userId      String
  user        AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  period      String
  periodStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, key, periodStart])
  @@index([key, periodStart])
  @@map("usage_counters")
}

model WatchlistItem {
  id           String    @id @default(cuid())
  watchlistId  String
  watchlist    Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  instrumentId String
  stock        Stock     @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol       String
  companyName  String?
  notes        String?
  tags         Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([watchlistId, instrumentId])
  @@index([watchlistId])
  @@index([instrumentId])
  @@map("watchlist_items")
}

model StrategyDecisionResult {
  id               String   @id @default(cuid())
  instrumentId     String?
  stock            Stock?    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  portfolioId      String?
  holdingId        String?
  symbol           String?
  country          String?
  exchange         String?
  strategy         String   // TREND_MOMENTUM, PULLBACK_IN_UPTREND, DEFENSIVE_EXIT
  decision         String   // TRADE_CANDIDATE, WATCH, WAIT, AVOID, EXIT_CANDIDATE, etc.
  action           String   // CONSIDER_ENTRY, WAIT_FOR_PULLBACK, etc.
  decisionScore    Int
  confidence       String   // LOW, MEDIUM, HIGH
  marketCondition  String
  marketGate       String
  entryZone        String?
  riskPlan         Json?
  scoreBreakdown   Json?
  reasons          Json
  blockers         Json
  warnings         Json
  dataGaps         Json
  strategyVersion  String?
  frameworkBacked  Boolean  @default(false)
  frameworkDecision String?
  frameworkAction  String?
  entryRulesPassed Json?
  exitRulesTriggered Json?
  noiseFiltersTriggered Json?
  strategyRating   Json?
  readinessLabel   String?
  modelVersion     String   @default("strategy-decision-v1")
  generatedAt      DateTime @default(now())
  generatedDate    DateTime // Normalized to UTC midnight for idempotency
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([instrumentId, strategy, modelVersion, generatedDate])
  @@index([instrumentId])
  @@index([portfolioId])
  @@index([strategy])
  @@map("strategy_decision_results")
}

model StrategyDefinition {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  description      String
  category         String
  style            String
  timeframe        String
  assetTypes       Json
  supportedRegions Json
  version          String
  status           String
  parameters       Json
  entryRules       Json
  exitRules        Json
  noiseFilters     Json
  riskRules        Json
  requiredInputs   Json
  marketGateRules  Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([style])
  @@map("strategy_definitions")
}

model StrategyPerformanceSummary {
  id                    String   @id @default(cuid())
  strategyCode          String
  strategyVersion       String
  timeframe             String
  region                String
  assetType             String
  universeKey           String   @default("DEFAULT")
  startingCapital       Float
  endingCapital         Float
  totalReturn           Float
  cagr                  Float?
  maxDrawdown           Float
  volatility            Float?
  sharpe                Float?
  winRate               Float?
  profitFactor          Float?
  tradeCount            Int
  averageHoldingDays    Float?
  exposurePercent       Float?
  benchmarkTotalReturn  Float?
  benchmarkCagr         Float?
  excessReturn          Float?
  excessCagr            Float?
  endOfTestExitPercent  Float?
  dataCoveragePercent   Float?
  ratingScore           Int
  ratingGrade           String
  automationEligibility String
  readinessLabel        String   @default("RESEARCH_ONLY")
  ratingReasons         Json?
  ratingWarnings        Json?
  ratingCapsApplied     Json?
  backtestRunId         String?
  generatedAt           DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([strategyCode, strategyVersion, timeframe, region, assetType, universeKey])
  @@index([strategyCode])
  @@index([ratingGrade])
  @@index([automationEligibility])
  @@map("strategy_performance_summaries")
}

model TradePlanResult {
  id                 String   @id @default(cuid())
  instrumentId       String
  strategyDecisionId String?
  portfolioId        String?
  portfolioKey       String   @default("NO_PORTFOLIO")
  symbol             String
  region             String?
  assetType          String?
  strategy           String
  strategyVersion    String
  strategyRating     String?
  readinessLabel     String?
  backtestTimeframe  String?
  backtestSummary    Json?
  strategyProofSnapshot Json?
  strategyDecisionSnapshot Json?
  latestPrice        Float?
  latestPriceTimestamp DateTime?
  marketDataSnapshot Json?
  dataQualitySnapshot Json?
  paperReadinessStatus String?
  paperReadinessReasons Json?
  paperReadinessBlockers Json?
  proofGeneratedAt   DateTime?
  snapshotVersion    String?
  planStatus         String
  riskGrade          String
  entryZone          Json?
  stopLoss           Json?
  target             Json?
  rewardRiskRatio    Float
  positionSizing     Json?
  portfolioImpact    Json?
  invalidationRules  Json?
  warnings           Json?
  blockers           Json?
  dataGaps           Json?
  modelVersion       String
  generatedAt        DateTime @default(now())
  generatedDate      DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([instrumentId, strategy, modelVersion, generatedDate, region, assetType, portfolioKey], map: "trade_plan_results_scope_portfolio_day_key")
  @@index([instrumentId])
  @@index([strategyDecisionId])
  @@index([portfolioId])
  @@index([region, assetType])
  @@index([paperReadinessStatus])
  @@index([strategyRating])
  @@index([readinessLabel])
  @@index([backtestTimeframe])
  @@map("trade_plan_results")
}

model TodayReviewRun {
  id              String   @id @default(cuid())
  runDate         DateTime
  region          String
  assetType       String
  status          String
  dataThroughDate DateTime?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  warnings        Json
  candidateCounts Json
  sourceSnapshot  Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  candidates      TodayReviewCandidate[]

  @@unique([runDate, region, assetType])
  @@index([region, assetType, runDate])
  @@map("today_review_runs")
}

model TodayReviewCandidate {
  id                    String   @id @default(cuid())
  runId                 String
  run                   TodayReviewRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  instrumentId          String
  symbol                String
  companyName           String?
  direction             String
  state                 String
  setupType             String?
  strategyCode          String
  strategyVersion       String?
  rank                  Int
  grade                 String
  confidenceScore       Int
  reasonSummary         String
  blockers              Json
  watchReasons          Json
  dataQualitySnapshot   Json?
  marketContextSnapshot Json?
  strategyProofSnapshot Json?
  tradePlanSnapshot     Json?
  sourceSignalSnapshot  Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([runId, instrumentId, strategyCode, direction])
  @@index([runId, rank])
  @@index([instrumentId])
  @@index([state])
  @@map("today_review_candidates")
}







