  region               String?  @default("GLOBAL")
  exchange             String?
  timestamp            DateTime
  open                 Decimal
  high                 Decimal
  low                  Decimal
  close                Decimal
  adjustedClose        Decimal? // crypto has no splits/divs → equals close
  volume               BigInt? // base-asset volume
  quoteVolume          Decimal? // quote-asset (USD) volume from Binance klines
  source               String? // e.g. BINANCE_KLINES
  ingestionTimestamp   DateTime @default(now())
  lastUpdatedTimestamp DateTime @updatedAt
  dataStatus           String   @default("COMPLETE")

  @@unique([symbol, timestamp])
  @@index([symbol, timestamp])
  @@map("crypto_price_ticks")
}

model CryptoLatestPrice {
