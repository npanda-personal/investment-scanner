model BacktestResult {
  id               String   @id @default(cuid())
  configId         String
  config           BacktestConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  startedAt        DateTime @default(now())
  completedAt      DateTime
  status           String   @default("completed") // "pending", "running", "completed", "failed"
  error            String?

  // Performance metrics
  sharpeRatio      Decimal?
  maxDrawdown      Decimal?
  winRate          Decimal?
  profitFactor     Decimal?
  totalReturn      Decimal?
  totalTrades      Int?

  // Detailed data
  equityCurve      Json?    // array of { timestamp: DateTime, equity: Decimal }
  tradeLedger      Json?    // array of trades
  monthlyReturns   Json?    // heatmap data

  @@index([configId])
  @@index([startedAt])
  @@map("backtest_results")
}