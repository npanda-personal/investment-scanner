# Database connection (matches docker-compose)
DATABASE_URL="postgresql://scanner:scanner_password@localhost:5432/investment_scanner?schema=public"

# JWT secret - generate a strong secret for production
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server port
PORT=3000

# Redis URL
REDIS_URL="redis://localhost:6379"

# External API keys (optional)
YAHOO_FINANCE_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
COINGECKO_API_KEY=""

# ── Crypto market data (FREE sources: CoinGecko + Binance) ───────────────────
# Crypto is the ONLY sanctioned external HTTP path; equities stay NSE/BSE file-only.
# Data is isolated in crypto_* tables. No API key required for the free tiers.
MARKET_DATA_CRYPTO_PROVIDER_ENABLED=true   # master switch for the crypto provider
MARKET_DATA_CRYPTO_LANE_ENABLED=true       # run the scheduler's 24/7 crypto lane
# COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# BINANCE_API_BASE=https://api.binance.com/api/v3
# CRYPTO_QUOTE_ASSET=USDT                   # Binance quote asset for pairs (BTCUSDT)
# CRYPTO_COINGECKO_THROTTLE_MS=6500         # spacing between CoinGecko pages (free tier)
# CRYPTO_BINANCE_THROTTLE_MS=250            # spacing between Binance klines requests
# CRYPTO_HTTP_TIMEOUT_MS=20000

# ── US / EU equities (FREE sources: NASDAQ Trader universe + Yahoo chart API) ─
# Per-region provider gate that lifts the global Yahoo/Angel disable for US/EU
# ONLY.  India stays strictly NSE/BSE file-based; crypto stays isolated.  No key,
# no paid provider.  Prices: query1.finance.yahoo.com/v8/finance/chart (keyless).
MARKET_DATA_US_PROVIDER_ENABLED=true     # enable US equity ingestion (Yahoo EOD)
MARKET_DATA_EU_PROVIDER_ENABLED=false    # EU rolls out after US is validated
# YAHOO_CHART_API_BASE=https://query1.finance.yahoo.com
# YAHOO_THROTTLE_MS=300                   # spacing between Yahoo chart requests
# YAHOO_HTTP_TIMEOUT_MS=20000
# US universe catalog (NASDAQ Trader public symbol directory; override only to mirror)
# MARKET_DATA_CATALOG_NASDAQ_LISTED_URL=https://www.nasdaqtrader.com/dynamic/SymDir/nasdaqlisted.txt
# MARKET_DATA_CATALOG_NASDAQ_OTHER_URL=https://www.nasdaqtrader.com/dynamic/SymDir/otherlisted.txt

# Market Data Foundation scheduler for latest completed daily candles
MARKET_DATA_SCHEDULER_ENABLED=true
MARKET_DATA_SCHEDULER_INTERVAL_MINUTES=15
# Comma-separated regions the scheduler syncs. US is seeded, so synced by default.
MARKET_DATA_SCHEDULER_REGIONS=IN,US
MARKET_DATA_SCHEDULER_ASSET_TYPE=STOCK
MARKET_DATA_SCHEDULER_BATCH_SIZE=25
MARKET_DATA_SCHEDULER_SYNC_DURING_MARKET_HOURS=false
MARKET_DATA_SCHEDULER_POST_CLOSE_WINDOW_MINUTES=120
MARKET_DATA_SCHEDULER_FINALIZATION_GRACE_MINUTES=15
MARKET_DATA_SCHEDULER_SKIP_WEEKENDS=true
MARKET_DATA_SCHEDULER_RUN_ON_STARTUP=true
MARKET_DATA_MANUAL_SYNC_COOLDOWN_MINUTES=15

# Market Data Foundation catalog URL imports (manual CSV remains available)
# NSE equity and ETF have safe public defaults; set these only to override.
MARKET_DATA_CATALOG_NSE_EQUITY_URL="https://nsearchives.nseindia.com/content/equities/sec_list.csv"
MARKET_DATA_CATALOG_NSE_ETF_URL="https://nsearchives.nseindia.com/content/equities/eq_etfseclist.csv"
MARKET_DATA_CATALOG_NSE_INDICES_URL="https://www.nseindia.com/api/allIndices"
MARKET_DATA_CATALOG_BSE_INDICES_URL="https://m.bseindia.com/IndicesView_New.aspx"
# No stable default F&O underlyings CSV is bundled; configure or use Manual CSV.
MARKET_DATA_CATALOG_NSE_FO_UNDERLYINGS_URL=""
MARKET_DATA_CATALOG_BSE_EQUITY_URL=""
MARKET_DATA_CATALOG_BROKER_SCRIP_MASTER_URL=""
MARKET_DATA_CATALOG_DOWNLOAD_TIMEOUT_MS=15000
MARKET_DATA_CATALOG_MAX_DOWNLOAD_MB=10
MARKET_DATA_CATALOG_TEMP_DIR=""
MARKET_DATA_CATALOG_KEEP_TEMP_FILES=false

# Market Data Foundation price backfill pacing
MARKET_DATA_PRICE_BACKFILL_CONCURRENCY=2
MARKET_DATA_PRICE_BACKFILL_PROVIDER_THROTTLE_MS=750
MARKET_DATA_STARTUP_PRICE_BACKFILL_ENABLED=true
MARKET_DATA_STARTUP_PRICE_BACKFILL_REGION=IN
MARKET_DATA_STARTUP_PRICE_BACKFILL_ASSET_TYPE=STOCK
MARKET_DATA_STARTUP_PRICE_BACKFILL_BATCH_SIZE=20
MARKET_DATA_STARTUP_PRICE_BACKFILL_WORKER_CONCURRENCY=2
MARKET_DATA_STARTUP_PRICE_BACKFILL_MAX_BATCHES=100

# Angel One SmartAPI read-only market data for IN / STOCK
# Orders stay disabled unless a later broker-execution requirement explicitly enables them.
ANGEL_ONE_API_KEY=""
ANGEL_ONE_CLIENT_CODE=""
ANGEL_ONE_PIN=""
ANGEL_ONE_TOTP_SECRET=""
ANGEL_ONE_APICONNECT_BASE_URL="https://apiconnect.angelone.in"
ANGEL_ONE_SCRIP_MASTER_URL="https://margincalculator.angelone.in/OpenAPI_File/files/OpenAPIScripMaster.json"
ANGEL_ONE_ENABLE_MARKET_DATA=false
ANGEL_ONE_PRIMARY_STATIC_IP=""
ANGEL_ONE_CLIENT_LOCAL_IP=""
ANGEL_ONE_CLIENT_PUBLIC_IP=""
ANGEL_ONE_CLIENT_MAC_ADDRESS=""
ANGEL_ONE_HISTORICAL_THROTTLE_MS=750
ANGEL_ONE_HISTORICAL_MAX_DAYS=500
ANGEL_ONE_FAIL_CLOSED=true
