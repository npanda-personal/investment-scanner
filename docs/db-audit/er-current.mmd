  %% Identity / billing
  AppUser ||--o| UserSubscription : userId
  AppUser ||--o{ UsageCounter : userId
  AppUser ||--o{ Portfolio : userId
  AppUser ||--o{ Watchlist : userId
  AppUser ||--o{ AlertRule : userId
  AppUser ||--o{ BacktestStrategy : userId
  AppUser ||--o{ BacktestRun : userId
