  Stock ||..o{ TradeJournalEntry : "instrumentId (soft)"
  SignalResult ||..o{ SignalCalibrationResult : "signalResultId (soft)"
  SignalResult ||..o{ SignalPositionLedgerEntry : "entrySignalId (soft)"
